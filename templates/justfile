# The commands every owt-stack app answers to. Copy to the app's repository and
# add the app's own recipes below the line. `just` lists them.
#
# `just check` is the gate: run it before every commit, and CI runs the same
# command (rust-ci.yml's `check-command: just check`), so the list of checks can't
# drift between the two. It migrates DATABASE_URL first, before anything compiles
# the `query!` macros against it: `just db` gives it a database of this app's own.

set dotenv-load := true
set shell := ["bash", "-euo", "pipefail", "-c"]

# List the recipes.
default:
    @just --list --unsorted

# Install the tools the recipes use, at the versions owt-stack's rust-ci.yml runs.
setup:
    npm ci
    cargo install sqlx-cli@0.9.0 --locked --no-default-features --features postgres,rustls
    cargo install cargo-audit@0.22.2 --locked

# Start Postgres and Redis (compose.yaml) and apply the migrations.
db: && migrate
    {{ compose }} up -d --wait

# DATABASE_URL must be a database of this app's own (`just db`'s, or a scratch one on
# a shared server): outside CI, the recipe refuses a server's shared `postgres` or
# `template1` database, which every app pointed at the server's default would migrate.
# In CI (`CI` set) the server is the job's own service, whatever its database's name.
# Without DATABASE_URL there is nothing to migrate, and the steps that need a schema
# fail on their own.
#
# Apply the migrations to DATABASE_URL (nothing for an app without migrations/).
migrate:
    #!/usr/bin/env bash
    set -euo pipefail
    [ -d migrations ] || exit 0
    if [ -z "${DATABASE_URL:-}" ]; then
        echo "migrate: DATABASE_URL is not set; nothing migrated (just db sets one up)" >&2
        exit 0
    fi
    name="${DATABASE_URL##*/}"
    name="${name%%\?*}"
    if [ -z "${CI:-}" ]; then
        case "$name" in
            postgres | template1 | "")
                echo "error: DATABASE_URL names the server's shared database ('$name'); give this app a database of its own" >&2
                exit 1 ;;
        esac
    fi
    sqlx migrate run

# Stop them (the data stays in the volume).
db-stop:
    {{ compose }} down

# Build the stylesheet.
css:
    npm run css:build

# Run the app, rebuilding the stylesheet on change.
dev: css
    #!/usr/bin/env bash
    set -euo pipefail
    # Invoke the binary directly: npx interposes a chain a single kill won't reach.
    ./node_modules/.bin/tailwindcss -i assets/app.css -o static/css/app.css --watch=always &
    watcher=$!
    trap 'kill $watcher 2>/dev/null' EXIT
    cargo run

# The migrations come first: `lint`, `doc` and `test` compile the `query!` macros,
# which read DATABASE_URL's schema unless SQLX_OFFLINE is set.
#
# Everything that must pass before a commit.
check: migrate fmt lint doc sqlx-check audit test

# Formatting, checked rather than applied: the gate must not change files.
fmt:
    cargo fmt --check

# Clippy, warnings fatal.
lint:
    cargo clippy --all-targets --locked -- -D warnings

# Rustdoc, private items included, warnings fatal.
doc:
    RUSTDOCFLAGS="-D warnings -A rustdoc::private_intra_doc_links" cargo doc --no-deps --document-private-items

# The committed .sqlx/ matches the queries, against DATABASE_URL's schema (skipped
# for an app without one).
sqlx-check: migrate
    if [ -d .sqlx ]; then SQLX_OFFLINE=false cargo sqlx prepare --check -- --all-targets; fi

# No advisories against Cargo.lock (ignored ones are in .cargo/audit.toml, with why).
audit:
    cargo audit --deny warnings

# The tests; arguments pass through (`just test --test worlds`).
test *args:
    cargo test --locked {{ args }}

# Regenerate .sqlx/ after changing a query.
prepare:
    cargo sqlx prepare -- --all-targets

# docker compose where Docker is, podman compose otherwise.
compose := `if docker compose version >/dev/null 2>&1; then echo "docker compose"; else echo "podman compose"; fi`

# ---- app recipes ----
